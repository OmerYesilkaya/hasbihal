{
  "name": "@hasbihal/desktop",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Hasbihal desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p e2e/tsconfig.json",
    "test:e2e": "electron-vite build && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hasbihal/config": "workspace:*",
    "@hasbihal/core": "workspace:*",
    "@hasbihal/protocol": "workspace:*",
    "@playwright/test": "1.65.1",
    "@tanstack/react-query": "5.108.2",
    "@types/hast": "3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@workadventure/noise-suppression": "0.2.0",
    "cldr-annotations-full": "49.0.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "emojibase-data": "18.0.0",
    "hast-util-to-jsx-runtime": "2.3.7",
    "highlight.js": "11.12.0",
    "jose": "6.2.17",
    "livekit-client": "2.24.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.74.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-virtuoso": "4.18.23",
    "sonner": "2.0.8",
    "vite": "8.3.8",
    "zod": "4.6.7"
  }
}
