# Copy to .env for local overrides. All values are optional in development.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
# Comma-separated origins allowed to call the API (desktop dev server and packaged app).
ALLOWED_ORIGINS=http://localhost:5173,app://hasbihal
# PostgreSQL from infra/compose.dev.yml.
DATABASE_URL=postgres://hasbihal:hasbihal-dev@127.0.0.1:5432/hasbihal
# Ed25519 key that signs access tokens. Optional in development (a temporary key is used);
# required in production. Generate with: pnpm --filter @hasbihal/server generate-signing-key
# AUTH_SIGNING_KEY=
# Set to true behind a reverse proxy, so rate limits see client IPs.
# TRUST_PROXY=false
# Requests per IP per minute on the unauthenticated auth routes (sign-in, access requests, …).
# AUTH_RATE_LIMIT_PER_MINUTE=20
# The client id of the app's Google OAuth client (a "Desktop app" client). Without it, Google
# sign-in is refused (README, "Signing in during development").
# GOOGLE_CLIENT_ID=
