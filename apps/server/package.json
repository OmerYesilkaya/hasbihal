{
  "name": "@hasbihal/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=.env src/cli/migrate.ts",
    "allow-email": "node --env-file-if-exists=.env src/cli/allow-email.ts",
    "set-email": "node --env-file-if-exists=.env src/cli/set-email.ts",
    "generate-signing-key": "node src/cli/generate-signing-key.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "@hasbihal/core": "workspace:*",
    "@hasbihal/protocol": "workspace:*",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "kysely": "0.29.9",
    "livekit-server-sdk": "2.19.3",
    "pg": "8.23.1",
    "rrule": "^2.8.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hasbihal/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "ws": "8.23.0"
  }
}
