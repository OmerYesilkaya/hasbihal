# Copy to .env and fill in. Never commit .env.

# The server's public name, e.g. a free DuckDNS subdomain.
HASBIHAL_HOST=hasbihal.duckdns.org

# Long random values. Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
LIVEKIT_API_SECRET=
# Keep this key name: livekit.yaml signs webhooks with it.
LIVEKIT_API_KEY=hasbihal

# Signs access tokens (an Ed25519 key, one line). Generate with:
#   openssl genpkey -algorithm ed25519 | awk 'NF {printf "%s\\n", $0}'
AUTH_SIGNING_KEY=
