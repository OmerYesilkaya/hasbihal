# Copy to .env and fill in. Never commit .env.

# The server's public name, e.g. a free DuckDNS subdomain.
HASBIHAL_HOST=hasbihal.duckdns.org

# Long random values. The database password goes into a URL, so it must be hex (base64's / and +
# break it): openssl rand -hex 32. The LiveKit secret can be either: openssl rand -base64 32
POSTGRES_PASSWORD=
LIVEKIT_API_SECRET=
# Keep this key name: livekit.yaml signs webhooks with it.
LIVEKIT_API_KEY=hasbihal

# Signs access tokens (an Ed25519 key, one line). Generate with:
#   openssl genpkey -algorithm ed25519 | awk 'NF {printf "%s\\n", $0}'
AUTH_SIGNING_KEY=

# The app's Google OAuth client id (README.md, "The desktop app for this server"). The server
# accepts only Google sign-ins made for it.
GOOGLE_CLIENT_ID=

# Backups (A31), encrypted with this password. Generate with: openssl rand -base64 32
# Keep a copy in your password manager: without it, the backups can't be read.
RESTIC_PASSWORD=
# Where backups go. To start without paying, a folder on this machine (not off-site):
RESTIC_REPOSITORY=/backups
# Off-site, Backblaze B2 through its S3-compatible API (see README.md, "Backups"):
#   RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/your-bucket/hasbihal
#   BACKUP_KEY_ID=your-application-key-id
#   BACKUP_KEY=your-application-key
