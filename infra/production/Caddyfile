# TLS from Let's Encrypt for HASBIHAL_HOST (a free DuckDNS name is fine), renewed automatically.
{$HASBIHAL_HOST} {
	encode zstd gzip

	# LiveKit signaling (WebSocket), at wss://<host>/livekit. Media itself is UDP, not proxied.
	handle_path /livekit/* {
		reverse_proxy host.docker.internal:7880
	}

	# The home and privacy pages Google's sign-in screen links to (A25).
	@site path / /privacy
	handle @site {
		root * /srv/site
		rewrite /privacy /privacy.html
		file_server
	}

	# Everything else is the Hasbihal API and gateway.
	handle {
		reverse_proxy server:8080
	}
}
